---
import Layout from "../layouts/Base.astro";
import { loadProjects, displayCategory } from "../lib/projects.js";

function categoryGlyph(cat) {
  const c = (cat || "").toLowerCase();
  if (c.includes("perpetual") || c.includes("dex") || c.includes("exchange")) return "◈";
  if (c.includes("game") || c.includes("chess")) return "♟";
  if (c.includes("ai") || c.includes("layer") || c.includes("infra")) return "▦";
  if (c.includes("defi")) return "◉";
  return "●";
}
function logoUrl(websiteUrl, slug) {
  let domain = "";
  if (websiteUrl) {
    try { domain = new URL(websiteUrl).hostname.replace(/^www\./, ""); } catch (e) { domain = ""; }
  }
  if (!domain) domain = `${slug}.com`;
  return `https://www.google.com/s2/favicons?domain=${domain}&sz=256`;
}
const CATEGORY_SHORT = {
  "perpetual-futures-dex": "Perp DEX",
  "perpetual futures exchange, defi": "Perp DEX",
  "perpetual futures dex": "Perp DEX",
  "ai and blockchain infrastructure - decentralized ai adjudication": "Infrastructure",
  "web3 gaming - blockchain chess with collectible and tournament mechanics": "Web3 Gaming",
};
function shortCategory(cat) {
  const c = (cat || "").trim();
  if (CATEGORY_SHORT[c.toLowerCase()]) return CATEGORY_SHORT[c.toLowerCase()];
  return c.split("-")[0].trim() || c;
}
function humanize(s) {
  return (s || "").replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
}
function shortFunding(summary) {
  const s = (summary || "").trim();
  const m = s.match(/[$€£]\s?\d+(?:\.\d+)?\s?[mbk]/i);
  return m ? m[0].replace(/\s+/g, "") : "";
}

const projects = loadProjects();
const all = projects.map((p) => {
  const row = p.project_row || {};
  const stageRaw = row.product_stage || "unknown";
  return {
    slug: row.slug, name: row.name, logo: logoUrl(row.website_url, row.slug),
    categoryShort: shortCategory(row.category || ""), fundingShort: shortFunding(row.funding_summary || ""),
    stageLabel: humanize(stageRaw.replace("incentive_driven_", "")),
    updated_at: row.updated_at || "",
  };
});

// New projects: most recently updated
const newProjects = [...all].sort((a, b) => (b.updated_at || "").localeCompare(a.updated_at || "")).slice(0, 6);

// Editor's choice: manual editorial picks (editable list). Not a ranking signal.
const EDITOR_CHOICE = ["perpl", "arcus"];
const editorChoice = EDITOR_CHOICE.map((s) => all.find((x) => x.slug === s)).filter(Boolean);
---

<Layout title="Before The Token" active="home">
  <section class="hero">
    <h1>Before The Token</h1>
    <p class="lead">
      Information platform, database, and research hub dedicated to crypto projects before they launch a token.
    </p>
    <p class="hero-cta">
      <a href="/projects" class="btn">Browse all projects →</a>
      <a href="/research" class="btn btn-ghost">Deep-dive research</a>
    </p>
  </section>

  <section class="home-section">
    <div class="home-head">
      <h2>New projects</h2>
      <a href="/projects" class="seeall">See all</a>
    </div>
    <div class="home-grid">
      {newProjects.map((x) => (
        <a class="hcard" href={`/${x.slug}`}>
          {x.logo ? (
            <img class="hlogo" src={x.logo} alt={x.name} width="34" height="34" loading="lazy" onerror={`this.outerHTML='<span class=&quot;hglyph&quot;>${categoryGlyph(x.categoryShort)}</span>'`} />
          ) : (
            <span class="hglyph">{categoryGlyph(x.categoryShort)}</span>
          )}
          <div class="hname">{x.name}</div>
          <div class="hcat">{x.categoryShort}</div>
        </a>
      ))}
    </div>
  </section>

  {editorChoice.length > 0 && (
    <section class="home-section">
      <div class="home-head">
        <h2>Editor's choice</h2>
        <span class="home-note">editorial pick, not a ranking</span>
      </div>
      <div class="home-grid">
        {editorChoice.map((x) => (
          <a class="hcard" href={`/${x.slug}`}>
            {x.logo ? (
              <img class="hlogo" src={x.logo} alt={x.name} width="34" height="34" loading="lazy" onerror={`this.outerHTML='<span class=&quot;hglyph&quot;>${categoryGlyph(x.categoryShort)}</span>'`} />
            ) : (
              <span class="hglyph">{categoryGlyph(x.categoryShort)}</span>
            )}
            <div class="hname">{x.name}</div>
            <div class="hcat">{x.fundingShort ? x.fundingShort : x.categoryShort}</div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="home-section home-links">
    <a href="/pulse" class="hlink">Pulse & updates →</a>
    <a href="/research" class="hlink">Research library →</a>
  </section>
</Layout>

<style>
  .hero { text-align: left; max-width: 720px; margin: 1rem 0 2.5rem; }
  .hero h1 { font-size: 2.4rem; letter-spacing: -0.8px; margin: 0 0 0.6rem; }
  .hero .lead { color: var(--muted); font-size: 1.05rem; line-height: 1.7; margin: 0 0 1.4rem; }
  .hero-cta { display: flex; gap: 0.7rem; flex-wrap: wrap; }
  .btn { display: inline-block; background: var(--accent); color: #fff; font-weight: 510; font-size: 0.92rem; padding: 0.55rem 1.1rem; border-radius: 9px; text-decoration: none; transition: background .15s; }
  .btn:hover { background: var(--accent-hover); text-decoration: none; color: #fff; }
  .btn-ghost { background: transparent; color: var(--accent); border: 1px solid var(--border-strong); }
  .btn-ghost:hover { background: var(--surface-2); color: var(--accent); }
  .home-section { margin: 2.5rem 0; }
  .home-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1rem; }
  .home-head h2 { font-size: 1.3rem; margin: 0; }
  .seeall { color: var(--accent); font-size: 0.88rem; font-weight: 510; text-decoration: none; }
  .seeall:hover { text-decoration: underline; }
  .home-note { color: var(--faint); font-size: 0.78rem; font-style: italic; }
  .home-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  @media (max-width: 900px) { .home-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .home-grid { grid-template-columns: 1fr; } }
  .hcard { display: flex; align-items: center; gap: 0.7rem; text-decoration: none; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1rem; box-shadow: var(--shadow); transition: border-color .15s, box-shadow .15s, transform .15s; }
  .hcard:hover { text-decoration: none; transform: translateY(-2px); border-color: var(--border-strong); box-shadow: var(--shadow-hover); }
  .hlogo, .hglyph { width: 2.1rem; height: 2.1rem; border-radius: 8px; object-fit: contain; flex: none; background: var(--surface-2); border: 1px solid var(--border); padding: 3px; }
  .hglyph { display: inline-flex; align-items: center; justify-content: center; background: rgba(91,94,240,0.10); color: var(--accent); font-size: 1.05rem; font-weight: 590; }
  .hname { font-weight: 590; color: var(--text); font-size: 0.98rem; }
  .hcat { color: var(--muted); font-size: 0.8rem; }
  .home-links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .hlink { color: var(--accent); font-weight: 510; text-decoration: none; }
  .hlink:hover { text-decoration: underline; }
</style>
